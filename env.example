# =============================================================================
#  Spotify Streaming Overlay — environment configuration
# =============================================================================
#  1. Copy this file to ".env.local"  ->  cp env.example .env.local
#  2. Create an app at https://developer.spotify.com/dashboard
#  3. Add the redirect URI below to your Spotify app settings (EXACTLY).
#  4. Paste your Client ID and Client Secret here.
# =============================================================================

# Your Spotify app's Client ID (public, from the developer dashboard).
SPOTIFY_CLIENT_ID=your_client_id_here

# Your Spotify app's Client Secret (PRIVATE — never commit, never expose client-side).
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# OAuth redirect URI. IMPORTANT: Spotify no longer allows "localhost" (since
# April 2025). You MUST use the explicit loopback IP 127.0.0.1.
# This exact value also has to be added in your Spotify app's "Redirect URIs".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
